    {
      "task_id": "array_second_distinct_001",
      "title": "Second Distinct Largest",
      "problem_statement": "Read integer n, then n space-separated integers containing at least two distinct values. Print the second distinct largest value.",
      "category": "array",
      "difficulty": "medium",
      "split": "validation",
      "visible_tests": [
        {"input": "5\n1 5 3 5 4", "expected_output": "4", "category": "normal"},
        {"input": "4\n9 8 7 6", "expected_output": "8", "category": "normal"}
      ],
      "hidden_tests": [
        {"input": "6\n2 2 1 3 3 0", "expected_output": "2", "category": "edge"},
        {"input": "5\n-1 -1 -2 -3 -2", "expected_output": "-2", "category": "edge"}
      ]
    },
    {
      "task_id": "sorting_without_builtin_001",
      "title": "Sort Without Built-ins",
      "problem_statement": "Read integer n, then n space-separated integers. Print them in nondecreasing order without using Python sort() or sorted().",
      "category": "sorting",
      "difficulty": "medium",
      "split": "hidden",
      "visible_tests": [
        {"input": "5\n3 1 4 1 2", "expected_output": "1 1 2 3 4", "category": "normal"},
        {"input": "3\n-1 -3 -2", "expected_output": "-3 -2 -1", "category": "edge"}
      ],
      "hidden_tests": [
        {"input": "1\n7", "expected_output": "7", "category": "edge"},
        {"input": "6\n0 -2 5 5 1 -2", "expected_output": "-2 -2 0 1 5 5", "category": "stress"}
      ]
    }
  ]
